s1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8212 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 which is the most demanding of all\uc1 \u8212 ?and I don\uc1 \u8217 ?t except the art of Demosthenes\uc1 \u8212 ?get someone to recite these pieces. You\uc1 \u8217 ?ll find them so cold, listless, and monotonous. There\uc1 \u8217 ?s nothing there which could serve as the basis for a melody. I\uc1 \u8217 ?d sooner have La Rochefoucauld\uc1 \u8217 ?s }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Maxims}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  or Pascal\uc1 \u8217 ?s }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Pens\uc1 \u233 ?es }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 to set to music.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \cs16 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \af5 \super1 \chftn {\footnote \pard \plain \li0 \ri0 \sa60 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \cs16 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \af5 \super1 \chftn }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 