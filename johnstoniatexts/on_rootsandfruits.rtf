105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 All thinking things, all objects of all thought,}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 And rolls through all things. (William Wordsworth)}{\cs15 \fs24 \rtlch \ltrch \dbch \af3 \hich \af5 \loch \af5 \lang4105 \langnp4105 \super1 \chftn {\footnote \pard \plain \s20 \li0 \ri0 \lisb0 \sa60 \lisa0 \nosnaplinegrid \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs18 \ltrch \fcs0 \fs18 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs20 \ltrch \fcs0 \cs15 \fs20 \rtlch \ltrch \dbch \af3 \hich \af5 \loch \af5 \super1 \chftn }{\rtlch \fcs1 \af5 \afs20 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  }{\rtlch \fcs1 \af5 \afs20 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 The experience Wordsworth explores here has been called the Oceanic feeling, \uc1 \u8220 ?a feeling of being one with the external world as a whole\uc1 \u8221 ? (Romain Rolland in a letter to Sigmund Freud, 1927). Freud usefully explains that the experience is a primitive ego-feeling related to the removal of breastfeeding in the infant.}}}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 Given this definition of religion and James\uc1 \u8217 ?s radically empirical frame of mind, his argument requires him to present a long list of those who offer detailed evidence of a personal apprehension of what they believe is the divine. And in judging the value of such a revelation, we must, as with all ideas, concentrate on its effects for the individual involved: \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 If the }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \cs17 \i1 \fs24 \rtlch \ltrch \dbch \af3 \hich \af5 \loch \f5 fruits for life}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  of the state of conversion are good, we ought to idealize and venerate it, even though it be a piece of natural psychology; if not, we ought to make short work with it, no matter what supernatural being may have infused it.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8221 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 James\uc1 \u8217 ?s argument has been criticized for, among other things, its very narrow definition of religion (and for, in James\uc1 \u8217 ?s words, \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 the admirable congruity of Protestant theology with the structure of the mind as shown in such experiences}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8221 ?), his neglect of ecclesiastic forms and practices and of the social aspects of religious experience, and its apparent relativism.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \cs15 \fs24 \rtlch \ltrch \dbch \af3 \hich \af5 \loch \af5 \lang4105 \langnp4105 \super1 \chftn {\footnote \pard \plain \s20 \li0 \ri0 \lisb0 \sa60 \lisa0 \nosnaplinegrid \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs18 \ltrch \fcs0 \fs18 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs20 \ltrch \fcs0 \cs15 \fs20 \rtlch \ltrch \dbch \af3 \hich \af5 \loch \af5 \super1 \chftn }{\rtlch \fcs1 \af5 \afs20 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  }{\rtlch \fcs1 \af5 \afs20 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 One standard pragmatist defence against a charge of \uc1 \u8220 ?anything goes\uc1 \u8221 ? relativism is that the actions an individual undertakes take place in a social context where laws, customs, and habits regulate what is and is not acceptable.}}}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025  But, whatever its limitations, his study of a large number of different individual experiences enables him to conclude that religious experience is an established fact (some people do have real feelings of a direct personal interaction with what they apprehend is the divine) and that the results of this interaction are often beneficial to the individual. }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 Establishing the truth of the experience is beyond the powers of rational thinking:}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 What religion reports, you must remember, always purports to be a fact of experience: the divine is actually present, religion says, and between it and ourselves relations of give and take are actual. If definite perceptions of fact like this cannot stand upon their own feet, surely abstract reasoning cannot give them the support they are in need of. Conceptual processes can class facts, define them, interpret them; but they do not produce them, nor can they reproduce their individuality.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025  . . . }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Philosophy in this sphere is thus a secondary function, unable to warrant faith's veracity, and so }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 . . . i}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 n all sad sincerity I think we must conclude that the attempt to demonstrate by purely intellectual processes the truth of the deliverances of direct religious experience is absolutely hopeless.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \sa120 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \ls0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 James points out that individuals differ in their religious and philosophical sensibilities and in the physical and mental circumstances they face in coping with their lives. Hence, we cannot expect all people to address their problems in the same way. Thus, we should leave them free to choose for themselves: \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 No two of us have identical difficulties, nor should we be expected to work out identical solutions. Each, from his peculiar angle of observation, takes in a certain sphere of fact and trouble, which each must deal with in a unique manner}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 .\uc1 \u8221 ? We all obviously require science, which brings us}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 telegraphy, electric ligh}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 ting}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 , and diagnosis, and succeeds in preventing and curing a certain amount of disease.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8221 ? But \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Religion in the shape of mind-cure gives to some of us serenity, moral poise, and happiness, and prevents certain forms of disease as well as science does, or even better in a certain class of persons.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8221 ? That being the case, \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 for each man to stay in his own experience, whate}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8217 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 er it be, and for others to tolerate him there, is surely best.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8221 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \sa120 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \ls0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \sa120 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \ls0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 James pleads for tolerance here because for him science and religion \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 are both of them genuine keys for unlocking the world's treasure-house to him who can use either of them practically. Just as evidently neither is exhaustive or exclusive of the other's simultaneous use}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 .\uc1 \u8221 ? This comment leaves me wondering why more scientists do not accept religion as perfectly explicable in terms of natural selection. After all, if a predisposition to religious belief is a heritable characteristic (as some scientists have already suggested) and if religious belief provides, as James asserts, valuable ways of coping with experience, then we have a perfectly acceptable Darwinian explanation for a refusal to accept Darwinism.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \sa120 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \ls0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \sa120 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \ls0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 The great power of the religious experience (as James has outlined it) stems from the fact that it is }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 personal}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 , for \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 To-day, quite as much as at any previous age, the religious individual tells you that the divine meets him on the basis of his personal concerns.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8221 ? Science, by contrast, has no room at all for a personal and direct relationship with reality:}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Probably a crab would be filled with a sense of personal outrage if it could hear us class it without ado or apology as a crustacean, and thus dispose of it. \uc1 \u8220 ?I am no such thing,\uc1 \u8221 ? it would say; \uc1 \u8220 ?I am myself, myself alone.\uc1 \u8221 ?}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 The disgruntled sea creature is here echoing the well-known complaint of Dostoevsky\uc1 \u8217 ?s Underground Man, who, for all his admiration of deterministic science, acknowledges that it is not nearly enough:}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 You see, gentlemen, reason is no more than reason, and it gives fulfillment only to man\uc1 \u8217 ?s reasoning capacity, while desires are a manifestation of the whole of life\uc1 \u8212 ?I mean the whole of human life, both with its reason and with all its itches and scratches. . . . I quite naturally want to live in order to fulfill my whole capacity for living, and not in order to fulfill my reasoning capacity alone, which is no more than some one-twentieth of my capacity for living. (}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 Notes from Underground}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 )}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li420 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \sa120 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \ls0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 Furthermore, this personal quality of the religious experience is much deeper and more powerful than any rational discussion about it:}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li420 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Your whole subconscious life, your impulses, your faiths, your needs, your divinations, have prepared the premises, of which your consciousness now feels the weight of the result; and something in you absolutely }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \cs17 \i1 \fs24 \rtlch \ltrch \dbch \af3 \hich \af5 \loch \f5 knows}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  that that result must be truer than any logic-chopping rationalistic talk, however clever, that may contradict it. This inferiority of the rationalistic level in founding belief is just as manifest when rationalism argues for religion as when it argues against it. }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 . . . }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li420 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin420 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 James states this as an empirical psychological fact derived from his numerous observations and is careful to add a note of caution: \uc1 \u8220 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Please observe, however, that I do not yet say that it is }{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \cs17 \i1 \fs24 \rtlch \ltrch \dbch \af3 \hich \af5 \loch \f5 better}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  that the subconscious and non-rational should thus hold primacy in the religious realm. I confine myself to simply pointing out that they do so hold it as a matter of fact}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 .\uc1 \u8221 ?}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 This promise of a personal connection to an eternal reality is presumably what many of those \uc1 \u8220 ?ordinary religious believer[s]\uc1 \u8221 ? whom James dismisses are seeking in their organized worship, even without having undergone a conversion experience of the sort James describes. One can hardly blame them for preferring that promise to what reductive biologists nowadays tell us we have become: }{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 nothing more than survival sites for DNA (most of it junk), genetically determined robots, temporary and random products of a process that didn\uc1 \u8217 ?t have us in mind, without free will, individual significance, or higher purpose, with a consciousness that is simply the product of mechanical biochemical reactions, a creature whose psychic wants can be reliably and conveniently met by anti-depressants and Ecstasy or soma on demand. Is it any wonder that some human beings think about this for moment and say, \uc1 \u8220 ?Thanks, but no thanks\uc1 \u8221 ??}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \s22 \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1 \ltrch \dbch \af6 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf1 Of course, it is important for all of us to be on our guard against and to call out as effectively as we can the charismatic religious scoundrels eager to transform their flocks into watered-down versions of the \uc1 \u8220 ?God Hates Fags\uc1 \u8221 ? quasi Taliban battalions or child-abusing polygamists. To that extent, those who like to voice their distrust of organized religion have a worthy mission. But when they seek to throw out the very dirty bathwater, they should take more care not to drown or disown the baby in the tub.}{\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1 \ltrch \dbch \af6 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf1 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \sl312 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af5 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }}