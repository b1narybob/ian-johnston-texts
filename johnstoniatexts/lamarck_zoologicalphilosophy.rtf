gfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 The }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 cirrhipedes}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 , for whom we as yet know only four genera}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \cs15 \fs24 \rtlch \ltrch \dbch \af3 \hich \af6 \loch \af6 \super1 \accnone0 \chftn {\footnote \pard \plain \s17 \ql \li0 \ri0 \nosnaplinegrid \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs18 \ltrch \fcs0 \fs18 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\cs15 \rtlch \ltrch \super1 \chftn }{\rtlch \fcs1 \af0 \afs18 \ltrch \fcs0 \fs18 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  }{\rtlch \fcs1 \af6 \afs20 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 The Anatifa, Balanus, Coronula and Tubicinella. }}}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025  must be considered as forming a special class, because these animals cannot be included in the group of any other class of invertebrate animals.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 They are like the mollusks on account of their mantle, and one has to place them immediately after the acephalid mollusks, since, like them, they lack heads and eyes.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 However, the cirrhipides cannot be included in the class of mollusks. For their nervous system displays, like the animals of the three classes which follow, a }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 longitudinal marrow with ganglia}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 . In addition, they have articulated arms with a horny skin and several pairs of transverse jaws. Thus, they are in a rank below that of the mollusks. The movements of their fluids takes place through a real circulation, with the help of arteries and veins.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 These animals are established on marine bodies and consequently do not move around. Thus, their main movements are limited to those of their arms. Now, although they have a mantle like the mollusks, nature could not gain any help for movements of their arms from that and was forced to create on the skin of these arms points of attachment for the muscles which must move them. Thus, this skin is tough and rather horny, like the skin of crustaceans and insects.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \qc \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 ANNELIDS}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \qc \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs20 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Animals with elongated and ringed bodies, without articulated limbs, breathing by gills, and with a circulatory system and a longitudinal marrow with ganglia.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 The class of }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 annelids }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 comes of necessity after the class of cirrhipedes, because no annelid has a mantle. We are also forced to place them before the crustaceans because these animals do not have articulated limbs, because they must not interrupt the series of those who have them, and because their organic structure does not permit us to assign them a rank after the insects.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Although these animals are, in general, as yet very little understood, the rank which their organic structure gives them proves that, so far as they are concerned, the }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 degradation }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 in organic structure continues to maintain itself. For, from this point of view, they are inferior to the mollusks, having a longitudinal marrow with ganglia. Moreover, they are also inferior to the }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \i1 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 cirrhipedes }{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 who have a mantle like the mollusks, and their lack of articulated limbs does not permit one to put them in a position where they break up the series of those manifesting this organic structure.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 The elongated shape of the annelids, which they owe to their ways of living, whether buried in the damp earth or silt, or in the waters, where they live, for the most part, in tubes of different materials, which they leave and return to as they wish, makes them so like worms that all the naturalists up to this point have confused them with worms.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 Their interior organic structure displays a very small brain, a longitudinal marrow with ganglia, some arteries and veins in which circulates a blood usually coloured red. They breathe through gills, sometimes external ones which project and sometimes internal ones hidden or not apparent.}{\rtlch \fcs1 \af6 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \sl276 \slmult1 \widctlpar \keep0 \keepn0 \aspalpha \aspnum \toplinepunct0 \faauto \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \ltrch \fcs0 \fs20 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \lan