p4105 \cf0 and shame as well, for all your days to come,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 if Achaeans strip my armour now I\uc1 \u8217 ?m down}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 [500]}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 among the fleet of ships. So hold your ground}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 with force. Spur on the army.\uc1 \u8221 ?}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0                                              }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe1033 \langfenp1033 \cf0    }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0                        As he said this,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 death\uc1 \u8217 ?s final end covered Sarpedon\uc1 \u8217 ?s eyes and nostrils.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Then Patroclus set his foot upon Sarpedon\uc1 \u8217 ?s chest,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 pulled his spear out of the body. The guts came with it.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 So in the same moment he tugged out the spear point}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 and took Sarpedon\uc1 \u8217 ?s life. Myrmidons reined in the horses,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 snorting in their eagerness to bolt, now they had left}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 590}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 their master\uc1 \u8217 ?s chariot.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \par }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0                              When Glaucus heard Sarpedon\uc1 \u8217 ?s voice,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 he was overcome with savage grief, his heart dismayed}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 that he could not have come to his assistance.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 With his hand he grabbed and squeezed his wounded arm,}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 [510]}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 still painful from being hit by Teucer\uc1 \u8217 ?s arrow,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 as he attacked him on that high defensive wall.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Teucer had been defending his companions}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 from disaster. So Glaucus prayed then to Apollo:}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \par }\pard \plain \s53 \li288 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin288 \rin0 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \uc1 \u8220 ?Hear me, my lord. You may be in Lycia,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 somewhere in that rich land, or here in Troy.}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 600}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 But you can hear a man\uc1 \u8217 ?s distress from anywhere.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Bitter grief has now come in my heart.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 For I have this cruel wound. Sharp pains}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 run up and down my arm, the flow of blood}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 won\uc1 \u8217 ?t stop. The wound wears out my shoulder,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 so I can\uc1 \u8217 ?t grip my spear with any force,}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 [520]}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 or move to fight against our enemies.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 And our finest man has perished\uc1 \u8212 ?Sarpedon,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 child of Zeus, who would not assist his son.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 But, my lord, heal my savage wound at least,}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 610}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 and ease my pain. Give me strength, so I can call}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 my Lycian comrades, urge them on to war,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 and I can fight in person by the corpse}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 of our Sarpedon now he\uc1 \u8217 ?s dead.\uc1 \u8221 ?}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0                                                   So Glaucus spoke in prayer.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Phoebus Apollo heard him. He eased the pains at once,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 stopped the dark blood flowing from the cruel wound,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 and filled his chest with fighting strength. In his heart}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Glaucus recognized with joy that the great god}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 [530]}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 had quickly heard his prayer. First, he moved around}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }