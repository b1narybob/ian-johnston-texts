\dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 630}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 he\uc1 \u8217 ?ll suffer much, our dear son Astyanax,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Lord of the City. Trojans called him this,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 because you alone kept their gates safe from harm,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 their towering walls. But now by the beaked ships,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 far from your parents, wriggling worms will eat you,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 once dogs have had their fill of your bare corpse.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 In your home are lovely well-made clothes,}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 [510]}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 produced by women\uc1 \u8217 ?s hands. In a blazing fire}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 I\uc1 \u8217 ?ll burn them all. They\uc1 \u8217 ?re no use to you,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 since you can\uc1 \u8217 ?t wear them. So I\uc1 \u8217 ?ll honour you,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 on behalf of Trojan men and women.\uc1 \u8221 ?}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s56 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Saying this, she wept. The women added their laments.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s56 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s56 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \sect }\sectd \sbkpage \pgwsxn12240 \pghsxn15840 \marglsxn1440 \margrsxn1440 \margtsxn1440 \margbsxn1440 \guttersxn0 \titlepg1 \headery709 \footery709 \pgbrdropt0 \sectlinegrid360 \sectdefaultcl \endnhere {\header \pard \plain \s55 \qc \li0 \ri0 \sa120 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \tqc \tx4680 \tql \tx5760 \tql \tx6192 \tqr \tx9360 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 \scaps1 Book Twenty-three}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 \scaps1 \par }}\pard \plain \s1 \qc \li0 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \outlinelevel0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 \scaps1 {\*\bkmkstart _Toc329759592}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \scaps1 \line }{\*\bkmkstart book23}{\*\bkmkend book23}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \scaps1 Book Twenty-Three}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \scaps1 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \scaps1 The Funeral Games for Patroclus}{\*\bkmkend _Toc329759592}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \scaps1 \par }\pard \plain \s56 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 {\i1 \fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 [Achilles keeps his troops together to mourn Patroclus; Patroclus's ghost visits Achilles, requesting a burial; Achaeans gather wood and prepare Patroclus's funeral pyre; Achilles cuts the hair dedicated to the river Spercheus; Achilles sacrifices animals and humans on Patroclus's pyre; Achilles gets the help of the winds to get the fire to light under Patroclus; Achilles brings out prizes for the Funeral Games, which then take place in series: the chariot race, boxing, wrestling, foot-racing, armed duelling, throwing a weight, archery, and spear throwing; Achilles awards Agamemnon the prize for the last event without any contest}{\i1 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 .}{\i1 \fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 ]}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s56 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Meanwhile, as Trojans were lamenting in the city,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Achaeans reached their ships beside the Hellespont.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 There they scattered, each man going to his own ship.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 But Achilles did not let his Myrmidons disband.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 He spoke out to his warrior companions:}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s53 \li288 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin288 \rin0 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \uc1 \u8220 ?Fast-riding Myrmidons, trusty comrades,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 let\uc1 \u8217 ?s not loose our sure-footed horses yet,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 untying them from their chariots. We must go}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 with horse and chariot up to Patroclus,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 to mourn for him. For that\uc1 \u8217 ?s a dead man\uc1 \u8217 ?s right.}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 10}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Once we\uc1 \u8217 ?ve had our fill of sorrowful tears,}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 [10]}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 we\uc1 \u8217 ?ll unyoke our horses, then all eat here.\uc1 \u8221 ?}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 At these words, they all began their group lament,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 led by Achilles. Three times around the body}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 they drove their well-groomed horses, mourning as they went.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Thetis stirred up in them a strong desire to weep.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Their tears made the sands wet, men\uc1 \u8217 ?s armour, too,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 for they were mourning the loss of a great warrior,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 who made men flee. Peleus\uc1 \u8217 ? son led their loud lament,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 placing his man-killing hands on his comrade\uc1 \u8217 ?s chest:}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 20}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf0 \par }\pard \plain \s53 \li288 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin288 \rin0 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbc