ard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 When Eurypylus, fine son of Euaemon,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 saw Ajax being attacked by this hail of spears,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 he went and stood by him. He hurled his shining spear}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \uc1 \u160 ?}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 650}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 and hit Apisaon, son of Phausius,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 a shepherd to his people, below his diaphragm,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 in the liver. His legs gave way. Eurypylus rushed up}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 [580]}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 to strip armour from his shoulders, but he was seen}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 by godlike Alexander, as he was pulling off}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 the armour from Apisaon. So Paris grabbed his bow,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 aimed at Eurypylus, then shot an arrow in his leg,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 his right thigh. The arrow shaft snapped off.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 His thigh was crippled. So Eurypylus moved back}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 among his comrades and thus escaped destruction.}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 660}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 But he shouted far and wide, calling to Danaans:}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf0 \par }\pard \plain \s53 \li288 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin288 \rin0 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \uc1 \u8220 ?Friends, leaders and rulers of the Argives,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 rally your ranks. Save Ajax from a brutal death.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 He\uc1 \u8217 ?s being attacked with spears, and I don\uc1 \u8217 ?t think}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 he\uc1 \u8217 ?s able to get out of this grim fight.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Come, stand by great Ajax, son of Telamon!\uc1 \u8221 ?}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 [590]}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Eurypylus yelled this out as he lay wounded.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Men closed their ranks around him, leaning their shields}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 against their shoulders with their spears extended.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Ajax came to meet them. When he reached his comrades,}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 670}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 he turned around and stood his ground once more.}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf0 \par }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Thus these soldiers went at the fight like a raging fire,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 as Neleus\uc1 \u8217 ?s horses carried Nestor from the fight.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Swift-footed Achilles, looking on, noticed Nestor.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Achilles stood by the stern of his broad-beamed ship,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe1033 \langfenp1033 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe1033 \langfenp1033 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 [600]}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 watching the harsh work of battle, the pitiful retreat.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 At once he spoke out to Patroclus, his companion,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 calling him beside the ship. From inside the hut}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Patroclus heard him. He came out, looking like Ares.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 This moment marked the start of his final rush to death.}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \uc1 \u160 ?}{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 680}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Patroclus, Menoetius\uc1 \u8217 ? fine son, was the first to speak:}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf0 \par }\pard \plain \s53 \li288 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin288 \rin0 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \uc1 \u8220 ?Why did you summon me, Achilles?}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Is there something you need me to carry out?\uc1 \u8221 ?}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \