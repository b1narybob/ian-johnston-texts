4105 \langfenp4105 \cf0 to be an excellent heroic warrior,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 when he\uc1 \u8217 ?d grown as tall as some young sapling,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 for I\uc1 \u8217 ?d raised him like a lovely orchard tree,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 I sent him out in the beaked ships to Ilion,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 to war against the Trojans. But now,}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 70}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe41