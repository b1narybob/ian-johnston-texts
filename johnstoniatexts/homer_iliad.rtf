2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Take a golden cord, hang it from heaven.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Let gods and goddesses, all together,}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 [20]}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 grab hold of one end of it and pull.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 You\uc1 \u8217 ?d not drag Zeus, the highest counsellor,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 down from heaven to the ground, never,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 no matter how hard you tried to do it.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 But when I wished to pull in earnest,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 I\uc1 \u8217 ?d yank up earth itself, the sea as well.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 I\uc1 \u8217 ?d loop that cord round some Olympian peak}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 30}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 and hang it in mid-air\uc1 \u8212 ?the whole of it.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 I\uc1 \u8217 ?m that much stronger than the gods and men.\uc1 \u8221 ?}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s53 \li288 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin288 \rin0 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s49 \li0 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs16 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Zeus finished. All the gods were speechless, shocked}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 at what Zeus had said, at the power of his tone.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 At last Athena, the bright-eyed goddess, spoke up:}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang2057 \langnp2057 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 [30]}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s49 \li0 \ri0 \s