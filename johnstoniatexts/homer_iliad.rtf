gfe4105 \langfenp4105 \cf0 to their hollow ships, so no one sees him,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 so no Danaan even is aware of him,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 until he comes to the son of Peleus.\uc1 \u8221 ?}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \s53 \li288 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin288 \rin0 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \par }\pard \plain \li0 \ri0 \sa0 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs20 \rtlch \ltrch \loch \af6 \hich \af0 \dbch \af2 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Hermes the Guide, killer of Argus, hearing Zeus,}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \uc1 \u160 ?\uc1 \u160 ?}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \