05 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 Though he\uc1 \u8217 ?s far off, cover him with glory now.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 For I\uc1 \u8217 ?ll tell you something\uc1 \u8212 ?and this will happen\uc1 \u8212 ?}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 if Athena and aegis-bearing Zeus permit me}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 to devastate that well-built city Ilion,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 you\uc1 \u8217 ?ll be the first to take the prize of honour,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe4105 \langfenp4105 \cf0 after me, of course\uc1 \u8212 ?a tripod, two horses,}{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f0 \lang4105 \langnp4105 \cf0 \tab }{\cs31 \fs