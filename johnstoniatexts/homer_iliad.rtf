ch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 she washed from her lovely body all the stains,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 then rubbed her skin with fragrant oil, divinely sweet,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 made specially for her. If this perfume were merely stirred}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 inside Zeus\uc1 \u8217 ?s bronze-floored house, its scent would then diffuse}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 throughout heaven and earth. She used this perfume}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 210}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af6 \loch \f6 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang4105 \l