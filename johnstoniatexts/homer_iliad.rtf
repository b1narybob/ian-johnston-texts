 }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \ltrch \loch \af0 \hich \af0 \dbch \af2 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf1 {\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Diomedes spoke. Famous spearman Odysseus}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 came up and made a stand before him. He sat down}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 behind Odysseus and pulled the arrow from his foot.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 Sharp pain shot through his flesh. Then he got in his chariot,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 took the reins, and with a heavy heart went to the hollow ships.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \tab }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 \tab }{\fs18 \rtlch \ltrch \dbch \af2 \hich \af6 \loch \f6 \lang2057 \langnp2057 \langfe1033 \langfenp1033 \cf0 [400]}{\fs24 \rtlch \ltrch \dbch \af6 \hich \af6 \loch \f6 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \cf0 \par }\pard \plain \s57 \li0 \ri0 \sb0 \sa0 \sbauto1 \saauto1 \widctlpar \aspalph