05 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 of curving horn, the din of tambourines,}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 as well as beating hands and Bacchic chants,}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 drowned out the music Orpheus was playing,}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 and finally the rocks turned red with blood,}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 for now the poet\uc1 \u8217 ?s song could not be heard. }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 First the women rip apart those creatures}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 still captivated by the singer\uc1 \u8217 ?s voice\uc1 \u8212 ?}{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af0 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe4105 \langfenp4105 countless birds, snakes, and throngs of savage beasts\uc1 \u8212 ?}{\fs24 \