ch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \tab }{\fs16 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \scaps1 PHINEUS}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 was talking about these things in the midst}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 of feasting with the Ethiopians,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 a noisy crowd filled the royal palace.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 The sound they made was not the merriment}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 of a wedding feast but one announcing}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 armed confrontation. The celebration}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang1033 \langnp1033 \langfe1033 \langfenp1033 instantly became a heated quarrel.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \la