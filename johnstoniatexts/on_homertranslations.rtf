in0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 SPEAK THROUGH ME, O MUSE,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 of that man of many devices}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 who wandered much}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 once he'd sacked the sacred citadel of Troy.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 He saw the cities of many men}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8                              and knew their minds,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 suffering many sorrows}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 in order to win back his life-soul}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 and the return of his companions.I}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 n the end he failed to save them,I}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 n spite of his longing to do so,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 for through their own heedlessness they perished.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 Fools -- who ate the cows of Helios-Hyperion,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 and the day of their return was taken from them.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 Of these matters, goddess, daughter of Zeus, speak through us}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 beginning wherever you will.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 When all the warriors who'd managed}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 to escape complete destruction}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 were back at home}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 safe from war and the sea,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 the queenly nymph Calypso, radiant goddess}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 detained only him}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 back in her hollow cavern}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 longing that he be her husband}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 though he longed only to return}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 and yearned for Penelope.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 And when as the seasons turned and the year came 'round}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 that the gods had appointed for him to sail home to Ithaka,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 he was not done with affliction even then,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 even among his own people.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 All the gods pitied him but Poseidon,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 who raged against Odysseus}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 until the time when he at last}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hi