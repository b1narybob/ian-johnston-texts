ch \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 Poseidon went to visit Ethiopians,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 the most remote of men. They live divided,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 some where the sun comes up, some where it sinks.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 They sacrificed a mass of lambs and bulls                  }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 to please the god, while fellow deities}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 assembled in Olympian Zeus's halls,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 where he, father of gods and men, spoke first,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 his mind consumed with thoughts of bold Aegisthus,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 whom Agamemnon's son Orestes killed.                     }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 Zeus spoke of him when he addressed the gods:}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \uc1 \u8220 ?Curious it is how mortals blame immortals,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 and say their troubles stem from us, when they}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 invite their own ordeals through foolish acts,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 just as Aegisthus did when, after he                               }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 wooed Agamemnon's wife, he killed the king,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 aware that ruin would follow. We warned him}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af0 \loch \f0 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \uc1 \u8212 ?}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af0 \loch \f0 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 sending our courier, Argus-slayer Hermes}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af0 \loch \f0 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \uc1 \u8212 ?}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af0 \loch \f0 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 neither to kill the man nor court his wife,}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 because his son Orestes would take vengeance                }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 when he became a man and journeyed home.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 So Hermes warned. Aegisthus did not take}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \line }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 our sound advice and now has paid full measure."}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 REVIEW COMMENT}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 Herbert Jordan's translation is a useful and workmanlike rendition of Homer's text. The more or less regular iambic pentameter lines set a good pace and keep the reader moving through the poem at a steady clip, as is appropriate to an often fast-paced narrative. The rhythm is generally effective, but while it does not get monotonous, it never really surprises. Jordan's language is for the most part straightforward and clear, easy to follow and effective. These qualities make the translation of the speeches work well--they sound as if they are words someone might actually say (an observation one cannot make about some translations).}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 At times one does get the sense, however, that the choice of words has been dictated by mechanical metrical requirements rather than by a desire for a direct and vivid impact. For example (chosen almost at random): \uc1 \u8220 ?Now protean Odysseus shed his rags,/ leapt to the threshold holding bow and quiver/ abrim with arrows, which he emptied out,/  dumped at his feet, proclaiming to the suitors:/ \uc1 \u8216 ?Thus will the baleful contest reach its end:/ a target no man ever hit till now--/ but if Apollo grants my prayer, I will.\uc1 \u8217 ?\uc1 \u8221 ? It's not clear to me what \uc1 \u8220 ?protean,\uc1 \u8221 ? \uc1 \u8220 ?abrim,\uc1 \u8221 ? and \uc1 \u8220 ?baleful\uc1 \u8221 ? add to the intense emotional quality of this dramatically vivid moment (compare their effect with that word "dumped," for instance)--they simply inject what sounds like a limp \uc1 \u8220 ?poetical\uc1 \u8221 ? tone in contrast to the direct and urgent clarity of the rest of the description. Some readers may well find this a minor cavil.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 As with his translation of the }{\i1 \fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 Iliad}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 , Jordan maintains a line-by-line fidelity to Homer's text; in order to do this with the shorter iambic pentameter line, he routinely leaves out words and phrases from the Greek. He does this because \uc1 \u8220 ?The object is to capture the essence of Homer's individual lines, not to render the Greek literally.\uc1 \u8221 ? This will not bother first-time readers, of course; they will not recognize what they are missing.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 The translation has useful notes (with some illustrations). The only one I might object to is the one for 1.122, explaining why the translation never attempts to deal with one of Homer's most famous metaphors, \uc1 \u8220 ?winged words.\uc1 \u8221 ? Jordan musters some impressive precedents to make his case, but the argument that the words are meaningless is unconvincing. I'm not sure that the best way to deal with a problematic phrase is simply to omit it, especially a metaphor as evocative as this one.}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs24 \rtlch \alang1 \ltrch \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1 {\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 For a more extensive preview of the Jordan translation (at Amazon), click }{\field \fldedit {\*\fldinst {\b1 \fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 }{\b1 \fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8  HYPERLINK "https://www.amazon.com/Odyssey-Oklahoma-Classical-Culture/dp/0806144122/ref=la_B002BTBGVK_1_2?s=books&ie=UTF8&qid=1394130099&sr=1-2&asin=0806144122&revisionId=&format=4&depth=1" }}{\fldrslt {\b1 \fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 }{\cs15 \b1 \fs24 \rtlch \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \cf14 \ul here}}}{\cs15 \b1 \fs24 \rtlch \ltrch \dbch \af2 \hich \af4 \loch \af4 \lang4105 \langnp4105 \cf14 \ul }{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 .}{\fs24 \rtlch \alang1 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1 \cf8 \par }\pard \plain \s22 \li0 \ri0 \sb100 \sa100 \sbauto1 \saauto1 