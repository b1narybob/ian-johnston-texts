025 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 Then prayed, when he had wandered afar upon the shore}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 A prayer to King Apollo whom well-haired Leto bore.}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \lisb0 \lisa0 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af5 \loch \af5 \lang1033 \langnp1033 \langfe2052 \langfenp2052 \alang1025 {\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \uc1 \u8220 ?Hear me, with bow of silver, who watch o\uc1 \u8217 ?er Chyrsa\uc1 \u8217 ?s land,}{\rtlch \fcs1 \af0 \afs24 \ltrch \fcs0 \fs24 \rtlch \alang1025 \ltrch \dbch \af2 \hich \af4 \loch \f4 \lang4105 \langnp4105 \langfe2052 \langfenp2052 \alang1025 \par }\pard \plain \li0 \ri0 \lis