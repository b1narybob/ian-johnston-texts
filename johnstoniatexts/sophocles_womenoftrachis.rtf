4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? or some foreigner?}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 MESSENGER}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? The herald Lichas}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? has announced the news to many people }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? in a summer pasture where cattle graze.}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 220}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? I heard it from him, and I rushed away,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? so I could be the very first to tell you}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 [190]}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? and benefit from doing you a favour.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 DEIANEIRA}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? If he has good news, why is he not here?}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 MESSENGER}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? Lady, he can hardly move. The Malians}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? have him surrounded, a whole crowd of them,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? standing in a circle asking questions.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? He cannot get away. They\uc1 \u8217 ?re all eager}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? to hear him tell them what they wish to know }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? and won\uc1 \u8217 ?t let Lichas leave until he does.}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 230}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? So he\uc1 \u8217 ?s being held up there against his will,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? because that\uc1 \u8217 ?s what those Malians demand.}{\*\bkmkstart t12}{\*\bkmkend t12}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? But soon you will see him arrive in person.}{\cs17 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \af5 \super1 \chftn {\footnote \pard \plain \s36 \li0 \ri0 \sa60 \sl240 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs27 \rtlch \ltrch \dbch \af2 \hich \af0 \loch \af0 \lang4105 \langnp4105 \langfe4105 \langfenp4105 {\cs17 \fs20 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \af5 \super1 \chftn }{\cs22 \fs20 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 The Malian Gulf was about six miles from Trachis. }}}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 DEIANEIRA}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? O Zeus, ruler of the uncut meadows,}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 [200]}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? lands of Oeta consecrated to you,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \