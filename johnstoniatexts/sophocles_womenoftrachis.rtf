105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? He has not arranged all that, my lady,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? for no reason or to make the girl a slave.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? You should not assume that\uc1 \u8217 ?s his intention.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? It\uc1 \u8217 ?s not likely, not if he is burning}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? with a hidden passion. I thought it right}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 450}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? to report all this to you, my lady,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? every detail I picked up from Lichas.}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich