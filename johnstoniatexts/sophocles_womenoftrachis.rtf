05 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? from someone dead, already down in Hades.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? And now this savage centaur, although dead,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? has robbed me of my life, as Zeus foretold.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? I will explain to you how later oracles}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? support the earlier one and thus confirm}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? the ancient utterance. I wrote them down}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? in the sacred precincts of the Selli,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? hill-dwellers who still sleep upon the ground.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? There my father\uc1 \u8217 ?s oak tree, which prophesies}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 1380}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? through many different tongues, revealed to me}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? that when the day arrived which has now come}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? I would be released from all the labours}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 [1170]}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? life had laid upon me, and I believed}{\*\bkmkstart t34}{\*\bkmkend t34}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? this meant I would enjoy a peaceful life.}{\cs17 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \af5 \super1 \chftn {\footnote \pard \plain \s36 \li0 \ri0 \sa60 \sl240 \slmult1 \widctlpar \aspalpha \aspnum \adjustright \lin0 \rin0 \itap0 \fs27 \rtlch \ltrch \dbch \af2 \hich \af0 \loch \af0 \lang4105 \langnp4105 \langfe4105 \langfenp4105 {\cs17 \fs20 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \af5 \super1 \chftn }{\cs22 \fs20 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 At Zeus\uc1 \u8217 ?s temple in Dodona, the rustling sounds in a sacred oak tree were interpreted by priestesses (see note 11 above). The Selli were a tribe living around Dodona. The comment about their sleeping on the ground is (according to Jebb) an indication that the Selli were a very old tribe with primitive customs.}{\fs20 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105  }}}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5  }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? But I can see it only meant that I would die, }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? for the dead no longer face a life of toil.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? Now, my boy, since these words are coming true,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? you must be my ally and stand with me.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? Don\uc1 \u8217 ?t hesitate\uc1 \u8212 ?you\uc1 \u8217 ?ll just provoke my rage.}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 1390}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? Agree to work with me, like a good child}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? who has discovered the most important rule\uc1 \u8212 ?}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? when fathers speak, their sons must all obey. }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 HYLLUS}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? Yes, father. At this point in our discussion,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \lang