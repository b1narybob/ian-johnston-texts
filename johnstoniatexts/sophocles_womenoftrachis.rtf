4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? an ancient tablet inscribed with symbols.}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? He\uc1 \u8217 ?d never thought of mentioning it before}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? when he was setting out on some adventure,}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 180}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? one of his many labours. He always left}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? full of confidence that he would triumph,}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \line }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ?\uc1 \u160 ? not like a man about to meet his death.}{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs22 \fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \tab }{\cs26 \fs18 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 [160]}{\fs24 \rtlch \ltrch \dbch \af2 \hich \af5 \loch \f5 \lang4105 \langnp4105 \langfe4105 \langfenp4105 \lin